<idea-plugin>
    <id>com.patrickreynolds.reviewmarks</id>
    <name>Review Marks</name>
    <vendor>Patrick Reynolds</vendor>
    <description>Mark code to review and as reviewed while you read. A line you edit inside reviewed code turns amber until you review it again. Review a branch or a GitHub pull request and post your notes as a review.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.github</depends>
    <depends>Git4Idea</depends>

    <projectListeners>
        <listener class="com.patrickreynolds.reviewmarks.FollowGitBranchListener"
                  topic="git4idea.repo.GitRepositoryChangeListener"/>
    </projectListeners>

    <applicationListeners>
        <listener class="com.patrickreynolds.reviewmarks.FocusAlertListener"
                  topic="com.intellij.openapi.application.ApplicationActivationListener"/>
    </applicationListeners>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.patrickreynolds.reviewmarks.FollowGitBranchOnStartup"/>
        <editorFactoryListener implementation="com.patrickreynolds.reviewmarks.ReviewMarksEditorListener"/>
        <applicationConfigurable parentId="tools"
                                 id="ReviewMarks.Settings"
                                 displayName="Review Marks"
                                 instance="com.patrickreynolds.reviewmarks.ReviewMarksConfigurable"/>
        <notificationGroup id="Review Marks" displayType="STICKY_BALLOON"/>
        <toolWindow id="Review Marks"
                    anchor="right"
                    icon="AllIcons.Actions.Checked"
                    factoryClass="com.patrickreynolds.reviewmarks.ReviewMarksToolWindowFactory"/>
        <statusBarWidgetFactory id="ReviewMarks.Progress"
                                implementation="com.patrickreynolds.reviewmarks.ReviewProgressWidgetFactory"/>
    </extensions>

    <actions>
        <action id="ReviewMarks.MarkAsToReview"
                icon="AllIcons.Actions.Preview"
                class="com.patrickreynolds.reviewmarks.MarkAsToReviewAction"
                text="Mark Selection to Review"
                description="Mark the selection (or the method or class at the caret) as code to review. It is listed in the To review tab.">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 7"/>
        </action>
        <action id="ReviewMarks.AddToFocus"
                class="com.patrickreynolds.reviewmarks.AddToFocusAction"
                text="Add Selection to Current Focus"
                description="Add the selection (or the method or class at the caret) to Current focus. It is highlighted red.">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 4"/>
        </action>
        <action id="ReviewMarks.MarkSelectionAsReviewed"
                icon="AllIcons.Actions.Checked"
                class="com.patrickreynolds.reviewmarks.MarkSelectionAsReviewedAction"
                text="Mark Selection as Reviewed"
                description="Highlight the selected code as reviewed.">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 8"/>
        </action>
        <action id="ReviewMarks.MarkEnclosingDeclarationAsReviewed"
                class="com.patrickreynolds.reviewmarks.MarkEnclosingDeclarationAsReviewedAction"
                text="Mark Method or Class at Caret as Reviewed"
                description="Mark the innermost multi-line method, class or other named declaration around the caret as reviewed."/>
        <action id="ReviewMarks.MarkAndGoToNext"
                icon="AllIcons.Actions.Play_forward"
                class="com.patrickreynolds.reviewmarks.MarkAndGoToNextAction"
                text="Mark as Reviewed and Go to Next"
                description="Mark the selection (or the method or class at the caret) as reviewed, then move to the next code to review.">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 9"/>
        </action>
        <action id="ReviewMarks.ClearReviewedMark"
                icon="AllIcons.Actions.Cancel"
                class="com.patrickreynolds.reviewmarks.ClearReviewedMarkAction"
                text="Clear Mark at Caret"
                description="Remove the mark under the caret."/>
        <action id="ReviewMarks.GoToNextRunToReview"
                icon="AllIcons.Actions.NextOccurence"
                class="com.patrickreynolds.reviewmarks.GoToNextRunToReviewAction"
                text="Go to Next Code to Review"
                description="Move the caret to the next code marked to review or changed since you reviewed it.">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 0"/>
        </action>
        <action id="ReviewMarks.GoBackToLastStop"
                icon="AllIcons.Actions.Back"
                class="com.patrickreynolds.reviewmarks.GoBackToLastStopAction"
                text="Go Back to Where I Stopped"
                description="Open the place where you last marked code as reviewed.">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 6"/>
        </action>
        <action id="ReviewMarks.ToggleFoldMode"
                class="com.patrickreynolds.reviewmarks.ToggleFoldModeAction"
                text="Focus Mode: Fold Reviewed Code"
                description="Fold reviewed code into a single line so that only code you have not read is on screen."/>

        <action id="ReviewMarks.ReviewBranchChanges"
                icon="AllIcons.Vcs.Branch"
                class="com.patrickreynolds.reviewmarks.ReviewBranchChangesAction"
                text="Review Branch Changes..."
                description="Pick a branch and mark the lines changed since you branched from it to review."/>
        <action id="ReviewMarks.MarkBranchChanges"
                icon="AllIcons.Vcs.Branch"
                class="com.patrickreynolds.reviewmarks.MarkBranchChangesAction"
                text="Mark All Branch Changes to Review"
                description="Mark every line changed on this branch since the default branch (main unless you set another in Settings) to review."/>
        <action id="ReviewMarks.MarkUncommittedChanges"
                icon="AllIcons.Vcs.CommitNode"
                class="com.patrickreynolds.reviewmarks.MarkUncommittedChangesAction"
                text="Mark Uncommitted Changes to Review"
                description="Mark every line that is not committed yet, including new files, to review."/>
        <action id="ReviewMarks.UndoLastClear"
                class="com.patrickreynolds.reviewmarks.UndoLastClearAction"
                text="Undo Last Clear or Delete"
                description="Bring back the marks or comments you last cleared or deleted."/>
        <action id="ReviewMarks.StartPullRequestReview"
                icon="AllIcons.Vcs.Merge"
                class="com.patrickreynolds.reviewmarks.StartPullRequestReviewAction"
                text="Start PR Review..."
                description="Find the GitHub pull request of the current branch and mark its changed lines to review. Your notes become review comments."/>
        <action id="ReviewMarks.PostPullRequestReview"
                class="com.patrickreynolds.reviewmarks.PostPullRequestReviewAction"
                text="Post PR Review..."
                description="Send your notes as a review on the pull request."/>
        <action id="ReviewMarks.EndPullRequestReview"
                class="com.patrickreynolds.reviewmarks.EndPullRequestReviewAction"
                text="End PR Review"
                description="Stop the PR review without posting it."/>

        <action id="ReviewMarks.AddNote"
                class="com.patrickreynolds.reviewmarks.AddNoteAction"
                text="Add Note..."
                description="Add a note for yourself on the selected lines (or the caret line).">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 1"/>
        </action>
        <action id="ReviewMarks.AddPullRequestComment"
                class="com.patrickreynolds.reviewmarks.AddPullRequestCommentAction"
                text="Add PR Comment..."
                description="Add a comment on the selected lines that is posted with your PR review.">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 2"/>
        </action>
        <action id="ReviewMarks.AddAgentNote"
                class="com.patrickreynolds.reviewmarks.AddAgentNoteAction"
                text="Add Agent Note..."
                description="Add feedback for Claude on the selected lines. Claude reads it with the review-agent-notes skill.">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift 3"/>
        </action>

        <action id="ReviewMarks.ShowReviewSummary"
                class="com.patrickreynolds.reviewmarks.ShowReviewSummaryAction"
                text="Show Today's Review Summary"
                description="Show what you reviewed today and what is left to review."/>

        <group id="ReviewMarks.Menu" text="Review Marks" popup="true">
            <reference ref="ReviewMarks.MarkAsToReview"/>
            <reference ref="ReviewMarks.AddToFocus"/>
            <reference ref="ReviewMarks.MarkAndGoToNext"/>
            <reference ref="ReviewMarks.MarkSelectionAsReviewed"/>
            <reference ref="ReviewMarks.MarkEnclosingDeclarationAsReviewed"/>
            <reference ref="ReviewMarks.ClearReviewedMark"/>
            <separator/>
            <reference ref="ReviewMarks.GoToNextRunToReview"/>
            <reference ref="ReviewMarks.GoBackToLastStop"/>
            <reference ref="ReviewMarks.AddNote"/>
            <reference ref="ReviewMarks.AddPullRequestComment"/>
            <reference ref="ReviewMarks.AddAgentNote"/>
            <reference ref="ReviewMarks.UndoLastClear"/>
            <reference ref="ReviewMarks.ShowReviewSummary"/>
            <separator/>
            <reference ref="ReviewMarks.ToggleFoldMode"/>
            <separator/>
            <reference ref="ReviewMarks.MarkBranchChanges"/>
            <reference ref="ReviewMarks.MarkUncommittedChanges"/>
            <reference ref="ReviewMarks.ReviewBranchChanges"/>
            <reference ref="ReviewMarks.StartPullRequestReview"/>
            <reference ref="ReviewMarks.PostPullRequestReview"/>
            <reference ref="ReviewMarks.EndPullRequestReview"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>

        <group id="ReviewMarks.FromGitMenu"
               popup="true"
               icon="AllIcons.Vcs.Branch"
               text="Review from Git"
               description="Mark changes from git or a pull request to review.">
            <reference ref="ReviewMarks.MarkBranchChanges"/>
            <reference ref="ReviewMarks.MarkUncommittedChanges"/>
            <reference ref="ReviewMarks.ReviewBranchChanges"/>
            <reference ref="ReviewMarks.StartPullRequestReview"/>
        </group>
    </actions>
</idea-plugin>
